# Copy to .env; never commit real passwords
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
DIRECTUS_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
DIRECTUS_ADMIN_EMAIL=admin@example.test
DIRECTUS_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
NUXT_PUBLIC_DIRECTUS_URL=http://localhost:8055
# Optional server-only token, never prefix with NUXT_PUBLIC_
DIRECTUS_SERVER_TOKEN=

# Optional server-side AI fallback (never expose this key in NUXT_PUBLIC_ variables)
OPENAI_API_KEY=

# Live Armenian biography reader; server-only credentials
NUXT_AZURE_SPEECH_KEY=
NUXT_AZURE_SPEECH_REGION=

# Optional dedicated Photon base URL for globe place search (default: public demo)
# NUXT_GEOGRAPHY_SEARCH_URL=https://your-photon-host.example
